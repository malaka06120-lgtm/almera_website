# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — server-only, NEVER expose to the browser or commit this file
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for metadata / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — https://resend.com/api-keys (used by /api/contact and new-order emails)
RESEND_API_KEY=re_your_resend_api_key
# Optional: verified sender address (defaults to Almera <onboarding@resend.dev> if unset)
RESEND_FROM_EMAIL=Almera <onboarding@resend.dev>

# Recipient(s) for new order notification emails — comma-separated for multiple.
# NOTE: while sending from the unverified onboarding@resend.dev test address,
# Resend only allows delivery to the account owner's own email. Adding more
# recipients requires verifying a domain at resend.com/domains first.
ADMIN_EMAIL=malak2004hamza@gmail.com

# Google Analytics 4 — Measurement ID (Admin > Data Streams > your stream)
# Optional: leave unset to skip loading Google Analytics entirely.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Meta (Facebook) Pixel ID — Events Manager > Data Sources > your pixel
# Optional: leave unset to skip loading the Meta Pixel entirely.
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
